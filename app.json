{
  "expo": {
    "name": "X Manager",
    "slug": "x-manager",
    "version": "1.1.0",
    "icon": "./assets/icon.png",
    "scheme": "xmanager",
    "platforms": ["android"],
    "backgroundColor": "#F5F3EC",
    "android": {
      "package": "app.xmanager.followlog",
      "versionCode": 2,
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain"]
          }
        }
      ]
    ]
  }
}
